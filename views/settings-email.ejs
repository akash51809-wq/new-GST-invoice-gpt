<%- include('partials/header') %>
<link rel="stylesheet" href="/settings.css">

<div class="settings-module" style="padding-top:10px;">
  <div class="settings-shortcuts" role="tablist">
    <a href="/settings/company" class="settings-shortcut" style="text-decoration:none;">
      <span>🏢</span><small class="setting-label">Company</small>
    </a>
    <a href="/settings/google" class="settings-shortcut" style="text-decoration:none;">
      <span>☁</span><small class="setting-label">Google Auth</small>
    </a>
    <a href="/settings/gemini" class="settings-shortcut" style="text-decoration:none;">
      <span>✦</span><small class="setting-label">Gemini AI</small>
    </a>
    <a href="/settings/email" class="settings-shortcut active" style="text-decoration:none;">
      <span>📝</span><small class="setting-label">Email Template</small>
    </a>
  </div>

  <% if(saved){ %>
    <div style="background:#DCFCE7;border:1px solid #86EFAC;color:#15803D;padding:12px 18px;border-radius:14px;margin-bottom:18px;font-size:13px;font-weight:700;display:flex;align-items:center;gap:8px;">
      <span>✓</span> Email template saved successfully!
    </div>
  <% } %>

  <div class="settings-panel active">
    <div class="settings-panel-title">
      <div class="panel-icon">📝</div>
      <div>
        <h2>Email Template Settings</h2>
        <p>जब पार्टी को इनवॉइस ऑटो-ईमेल किया जाएगा, तो यही Subject और Message जाएगा।</p>
      </div>
    </div>

    <form method="POST" action="/settings/email">
      <div style="padding:24px;border-radius:20px;background:#fff;border:1px solid #E2E8F0;box-shadow:10px 12px 22px rgba(15,23,42,0.06);">
        <div style="margin-bottom:16px;">
          <label style="display:block;font-size:12px;font-weight:800;color:#334155;margin-bottom:8px;">Email Subject</label>
          <input name="subject" value="<%= subject %>" required placeholder="Tax Invoice from {COMPANY_NAME} - {BILL_NUMBER}" style="width:100%;height:44px;padding:0 14px;border:1px solid #CBD5E1;border-radius:12px;font-size:13px;outline:none;">
        </div>

        <div style="margin-bottom:16px;">
          <label style="display:block;font-size:12px;font-weight:800;color:#334155;margin-bottom:8px;">Email Body / Message</label>
          <textarea name="body" required placeholder="Dear {PARTY_NAME},\n\nPlease find attached invoice..." style="width:100%;min-height:160px;padding:14px;border:1px solid #CBD5E1;border-radius:14px;font-size:13px;outline:none;resize:vertical;"><%= body %></textarea>
        </div>

        <div style="background:#F8FAFC;border:1px solid #E2E8F0;padding:14px;border-radius:12px;font-size:11px;color:#475569;margin-bottom:18px;">
          <strong style="color:#0F172A;display:block;margin-bottom:4px;">Supported Dynamic Variables:</strong>
          <code>{COMPANY_NAME}</code>, <code>{PARTY_NAME}</code>, <code>{BILL_NUMBER}</code>, <code>{AMOUNT}</code>, <code>{DATE}</code>
        </div>

        <button type="submit" class="primary" style="height:44px;padding:0 24px;font-size:12px;">Save Email Template</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
