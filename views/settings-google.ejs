<%- include('partials/header') %><div class="top"><div><div class="title">Google Drive / Gmail Settings</div><div class="sub">Google OAuth credentials और account connection</div></div><a class="btn" href="/auth/google">Connect Google Account</a></div><% if(saved){ %><div class="alert">Settings saved</div><% } %><div class="panel"><form class="form" method="post"><label>Google Client ID<input name="googleClientId" value="<%=process.env.GOOGLE_CLIENT_ID||''%>"></label><label>Google Client Secret<input name="googleClientSecret" value="<%=process.env.GOOGLE_CLIENT_SECRET||''%>" type="password"></label><label>Google Redirect URI<input name="googleRedirectUri" value="<%=process.env.GOOGLE_REDIRECT_URI||''%>"></label><label>Gmail From Name<input name="gmailFromName" value="<%=process.env.GMAIL_FROM_NAME||''%>"></label><button class="btn">Submit & Save to .env</button></form></div><div class="panel"><h3>महत्वपूर्ण</h3><p class="small">Google Drive और Gmail दोनों के लिए OAuth authorization जरूरी है। Credentials server-side रखें।</p></div><%- include('partials/footer') %>
