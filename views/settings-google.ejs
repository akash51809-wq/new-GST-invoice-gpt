<%- include('partials/header') %>
<link rel="stylesheet" href="/settings.css">

<div class="settings-module" style="padding-top:10px;">
  <div class="settings-shortcuts" role="tablist">
    <a href="/settings/company" class="settings-shortcut" style="text-decoration:none;">
      <span>🏢</span><small class="setting-label">Company</small>
    </a>
    <a href="/settings/google" class="settings-shortcut active" style="text-decoration:none;">
      <span>☁</span><small class="setting-label">Google Auth</small>
    </a>
    <a href="/settings/gemini" class="settings-shortcut" style="text-decoration:none;">
      <span>✦</span><small class="setting-label">Gemini AI</small>
    </a>
    <a href="/settings/email" class="settings-shortcut" style="text-decoration:none;">
      <span>📝</span><small class="setting-label">Email Template</small>
    </a>
  </div>

  <% if(saved){ %>
    <div style="background:#DCFCE7;border:1px solid #86EFAC;color:#15803D;padding:12px 18px;border-radius:14px;margin-bottom:18px;font-size:13px;font-weight:700;display:flex;align-items:center;gap:8px;">
      <span>✓</span> Google credentials saved successfully!
    </div>
  <% } %>

  <div class="settings-panel active">
    <div class="settings-panel-title" style="display:flex;justify-content:space-between;align-items:center;">
      <div style="display:flex;align-items:center;gap:12px;">
        <div class="panel-icon">☁</div>
        <div>
          <h2>Google Drive &amp; Gmail Settings</h2>
          <p>Google OAuth credentials और Google Drive / Gmail का ऑटोमेशन कनेक्शन</p>
        </div>
      </div>
      <a class="primary" href="/auth/google" style="text-decoration:none;font-size:11px;padding:10px 18px;">
        ⚡ Connect Google Account
      </a>
    </div>

    <form method="POST" action="/settings/google">
      <div style="padding:24px;border-radius:20px;background:#fff;border:1px solid #E2E8F0;box-shadow:10px 12px 22px rgba(15,23,42,0.06);display:grid;gap:16px;">
        <div>
          <label style="display:block;font-size:12px;font-weight:800;color:#334155;margin-bottom:6px;">Google Client ID</label>
          <input name="googleClientId" value="<%= process.env.GOOGLE_CLIENT_ID || '' %>" placeholder="Enter Google Client ID" style="width:100%;height:44px;padding:0 14px;border:1px solid #CBD5E1;border-radius:12px;font-size:13px;outline:none;">
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:800;color:#334155;margin-bottom:6px;">Google Client Secret</label>
          <input name="googleClientSecret" value="<%= process.env.GOOGLE_CLIENT_SECRET || '' %>" type="password" placeholder="Enter Google Client Secret" style="width:100%;height:44px;padding:0 14px;border:1px solid #CBD5E1;border-radius:12px;font-size:13px;outline:none;">
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:800;color:#334155;margin-bottom:6px;">Google Redirect URI</label>
          <input name="googleRedirectUri" value="<%= process.env.GOOGLE_REDIRECT_URI || '' %>" placeholder="http://localhost:4322/auth/google/callback" style="width:100%;height:44px;padding:0 14px;border:1px solid #CBD5E1;border-radius:12px;font-size:13px;outline:none;">
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:800;color:#334155;margin-bottom:6px;">Gmail From Display Name</label>
          <input name="gmailFromName" value="<%= process.env.GMAIL_FROM_NAME || '' %>" placeholder="GST Invoice Manager" style="width:100%;height:44px;padding:0 14px;border:1px solid #CBD5E1;border-radius:12px;font-size:13px;outline:none;">
        </div>
        <div>
          <button type="submit" class="primary" style="height:44px;padding:0 24px;font-size:12px;">Save Google Settings</button>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
