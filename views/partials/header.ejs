<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1E293B">
  <title><%= typeof title !== 'undefined' ? title : 'GST Invoice Manager' %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/dashboard.css">
  <style>
    .profile-menu-wrap{position:relative}
    .profile-trigger{border:0;cursor:pointer}
    .profile-menu{position:absolute;right:0;top:52px;width:260px;padding:10px;background:#fff;border:1px solid #E2E8F0;border-radius:18px;box-shadow:12px 16px 30px rgba(15,23,42,.16),inset 1px 1px 2px rgba(255,255,255,.95);opacity:0;visibility:hidden;transform:translateY(-7px) scale(.98);transform-origin:top right;transition:.18s;z-index:200}
    .profile-menu-wrap.open .profile-menu{opacity:1;visibility:visible;transform:translateY(0) scale(1)}
    .profile-menu-head{display:flex;align-items:center;gap:10px;padding:8px 8px 11px}
    .profile-avatar-large{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(145deg,#3B82F6,#1E3A8A);color:#fff;font-size:12px;font-weight:900;box-shadow:5px 6px 11px rgba(37,99,235,.2),inset 1px 1px 2px rgba(255,255,255,.3)}
    .profile-menu-head strong,.profile-menu-head small{display:block}
    .profile-menu-head strong{font-size:12px;color:#0F172A}
    .profile-menu-head small{font-size:10px;color:#64748B;margin-top:3px}
    .profile-divider{height:1px;background:#E2E8F0;margin:4px 0 8px}
    .profile-menu-link{display:flex;align-items:center;gap:10px;text-decoration:none;color:#334155;padding:10px 9px;border-radius:11px;font-size:11px;font-weight:700;transition:.15s}
    .profile-menu-link:hover{background:#EFF6FF;color:#1E3A8A}
    .profile-menu-link.logout:hover{background:#FEF2F2;color:#EF4444}
    .profile-menu-link span{width:26px;height:26px;border-radius:8px;display:grid;place-items:center;background:#F1F5F9;color:#2563EB;font-size:12px}
    .profile-menu-link.logout span{background:#FEE2E2;color:#EF4444}
    .sidebar-nav a.active{background:linear-gradient(135deg,rgba(37,99,235,.52),rgba(13,148,136,.38))!important;border-color:rgba(125,211,252,.4)!important;color:#fff!important}
  </style>
</head>
<body>
  <div class="ambient ambient-one"></div>
  <div class="ambient ambient-two"></div>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-top">
        <div class="brand-3d">
          <div class="brand-logo">₹</div>
          <div class="brand-copy">
            <strong>GST INVOICE</strong>
            <span>MANAGER</span>
          </div>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a class="<%= (typeof page !== 'undefined' && page === 'dashboard') ? 'active' : '' %>" href="/dashboard"><span class="nav-icon">⌂</span><span>Dashboard</span><em>01</em></a>
        <a class="<%= (typeof page !== 'undefined' && page === 'upload') ? 'active' : '' %>" href="/invoices/upload"><span class="nav-icon">↥</span><span>Upload Invoice</span><em>02</em></a>
        <div class="nav-group">
          <a class="nav-parent <%= (typeof page !== 'undefined' && page === 'reports') ? 'active' : '' %>" href="/reports/invoices"><span class="nav-icon">▤</span><span>Report</span><em>03</em></a>
        </div>
        <a class="<%= (typeof page !== 'undefined' && page === 'parties') ? 'active' : '' %>" href="/parties"><span class="nav-icon">♙</span><span>Party List</span><em>04</em></a>
        <a class="<%= (typeof page !== 'undefined' && page === 'settings') ? 'active' : '' %>" href="/settings/company"><span class="nav-icon">⚙</span><span>Settings</span><em>05</em></a>
      </nav>
      <div class="sidebar-bottom">
        <div class="mini-company">
          <div class="company-orb">₹</div>
          <div>
            <strong><%= typeof companyName !== 'undefined' && companyName ? companyName : 'GST Workspace' %></strong>
            <small>Active Workspace</small>
          </div>
        </div>
        <form action="/logout" method="POST" style="margin:0;padding:0;">
          <button class="logout-btn" type="submit"><span>↪</span><b>Logout</b><small>Exit</small></button>
        </form>
      </div>
    </aside>
    <main class="main">
      <header class="topbar">
        <div class="heading-block">
          <div class="breadcrumb"><span>GST MANAGER</span><b>/</b><span id="crumbTitle"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></span></div>
          <h1 id="pageTitle"><%= typeof pageHeading !== 'undefined' ? pageHeading : 'Dashboard' %></h1>
        </div>
        <div class="top-actions">
          <a class="icon-btn" href="/reports/invoices" title="Search Invoices" style="display:grid;place-items:center;text-decoration:none;">⌕</a>
          <a class="notify-btn" href="/reports/invoices" title="Notifications" style="display:grid;place-items:center;text-decoration:none;">◌<i></i></a>
          <div class="profile-menu-wrap" id="profileMenuWrap">
            <button class="avatar profile-trigger" type="button" aria-label="Profile menu" id="profileTrigger"><%= typeof userName !== 'undefined' && userName ? userName.slice(0, 2).toUpperCase() : 'AD' %></button>
            <div class="profile-menu" id="profileDropdown">
              <div class="profile-menu-head">
                <div class="profile-avatar-large"><%= typeof userName !== 'undefined' && userName ? userName.slice(0, 2).toUpperCase() : 'AD' %></div>
                <div>
                  <strong><%= typeof companyName !== 'undefined' && companyName ? companyName : 'GST Workspace' %></strong>
                  <small><%= typeof userName !== 'undefined' && userName ? userName : 'Administrator' %></small>
                </div>
              </div>
              <div class="profile-divider"></div>
              <a class="profile-menu-link" href="/settings/company">
                <span>⚙</span> Settings & Profile
              </a>
              <form action="/logout" method="POST" style="margin:0;padding:0;">
                <button type="submit" class="profile-menu-link logout" style="width:100%;border:0;background:transparent;cursor:pointer;font-family:inherit;">
                  <span>↪</span> Logout
                </button>
              </form>
            </div>
          </div>
        </div>
      </header>
