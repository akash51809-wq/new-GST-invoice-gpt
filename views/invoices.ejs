<%- include('partials/header') %>
<link rel="stylesheet" href="/upload-invoice.css">

<div id="upload-invoice-report" class="report-subpage active" style="padding-top:4px;">
  <div class="report-upload-shell">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
      <div>
        <h2 style="margin:0;font-size:22px;color:#0F172A;letter-spacing:-.5px;">Invoice Report</h2>
        <p style="margin:3px 0 0;font-size:12px;color:#64748B;">Detailed record of all BUY and SELL invoices uploaded to the system</p>
      </div>
      <a class="primary light" href="/reports/export.csv" style="text-decoration:none;display:inline-flex;align-items:center;gap:6px;font-size:11px;">
        ⬇ Export CSV
      </a>
    </div>

    <!-- Filter Bar matching upload-invoice.css -->
    <form method="GET" action="/reports/invoices" class="report-filter-bar">
      <div class="report-filter-field">
        <label for="reportFinYear">Fin Year</label>
        <select id="reportFinYear" name="financialYear">
          <option value="">All Financial Years</option>
          <option value="2024-25" <%= query.financialYear === '2024-25' ? 'selected' : '' %>>2024-25</option>
          <option value="2025-26" <%= query.financialYear === '2025-26' ? 'selected' : '' %>>2025-26</option>
          <option value="2026-27" <%= query.financialYear === '2026-27' ? 'selected' : '' %>>2026-27</option>
        </select>
      </div>

      <div class="report-filter-field">
        <label for="reportMonth">Month</label>
        <select id="reportMonth" name="month">
          <option value="">All Months</option>
          <% ['April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December', 'January', 'February', 'March'].forEach(m => { %>
            <option value="<%= m %>" <%= query.month === m ? 'selected' : '' %>><%= m %></option>
          <% }) %>
        </select>
      </div>

      <div class="report-filter-field">
        <label for="reportType">Buy / Sell</label>
        <select id="reportType" name="type">
          <option value="ALL" <%= (!query.type || query.type === 'ALL') ? 'selected' : '' %>>All</option>
          <option value="BUY" <%= query.type === 'BUY' ? 'selected' : '' %>>Buy</option>
          <option value="SELL" <%= query.type === 'SELL' ? 'selected' : '' %>>Sell</option>
        </select>
      </div>

      <div class="report-filter-field">
        <label for="reportParty">Party Name / Inv No</label>
        <input id="reportParty" name="search" type="search" placeholder="Search party or invoice..." value="<%= query.search || '' %>" autocomplete="off">
      </div>

      <button id="reportSearchBtn" class="report-search-btn" type="submit">
        <span>⌕</span> Search
      </button>

      <a id="reportResetBtn" class="report-reset-btn" href="/reports/invoices" style="text-decoration:none;">
        <span>↺</span> Reset
      </a>

      <div id="reportFilterCount" class="report-filter-count">
        Showing <%= invoices.length %> invoice record<%= invoices.length === 1 ? '' : 's' %>
      </div>
    </form>

    <!-- Table Card matching upload-invoice.css -->
    <div class="report-table-card">
      <div class="report-table-head">
        <h3>Invoice Report</h3>
        <span id="reportRowCount"><%= invoices.length %> record<%= invoices.length === 1 ? '' : 's' %></span>
      </div>
      <div class="report-table-wrap">
        <table>
          <thead>
            <tr>
              <th style="width:45px;">Sl No</th>
              <th>Fin Year</th>
              <th>Month</th>
              <th>Inv No</th>
              <th>Party Name</th>
              <th>Invoice Type</th>
              <th>Amount</th>
              <th style="text-align:center;width:150px;">Actions</th>
            </tr>
          </thead>
          <tbody id="reportTableBody">
            <% if (!invoices || !invoices.length) { %>
              <tr>
                <td colspan="8" class="report-empty">No invoice records found matching the criteria.</td>
              </tr>
            <% } else { %>
              <% invoices.forEach((x, i) => { %>
                <tr>
                  <td class="sl-cell"><%= i + 1 %></td>
                  <td><%= x.financialYear || '-' %></td>
                  <td><%= x.month || '-' %></td>
                  <td><strong style="color:#2563EB;"><%= x.invoiceNumber || '-' %></strong></td>
                  <td class="party-cell">
                    <strong><%= x.invoiceType === 'BUY' ? x.sellerName : x.buyerName %></strong>
                    <small>GSTIN: <%= (x.invoiceType === 'BUY' ? x.sellerGSTIN : x.buyerGSTIN) || '-' %></small>
                  </td>
                  <td>
                    <span class="type-pill <%= x.invoiceType === 'BUY' ? 'type-buy' : 'type-sell' %>">
                      <%= x.invoiceType %>
                    </span>
                  </td>
                  <td class="amount-cell">₹ <%= (x.invoiceAmount || 0).toLocaleString('en-IN') %></td>
                  <td style="text-align:center;">
                    <div class="action-group" style="justify-content:center;">
                      <a class="report-action action-view" href="/invoice/<%= x._id %>/view" title="View Details">👁</a>
                      <a class="report-action action-download" href="/invoice/<%= x._id %>/download" title="Download PDF">⬇</a>
                      <form style="display:inline;margin:0;" method="POST" action="/invoice/<%= x._id %>/email">
                        <button type="submit" class="report-action action-edit" title="Send Email" style="border:none;">✉</button>
                      </form>
                      <button type="button" class="report-action action-delete" onclick="openDeletePinModal('<%= x._id %>', '<%= (x.invoiceNumber || '').replace(/'/g, '\\\'') %>')" title="Delete Invoice">⌫</button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modern Delete Modal matching GSTUI-main -->
<div id="reportDeleteModal">
  <div class="delete-dialog">
    <div class="delete-icon">⌫</div>
    <h3>Delete Invoice?</h3>
    <p>Are you sure you want to permanently delete invoice <strong id="deleteModalInvNum" style="color:#0F172A;"></strong>? This action will remove the record and Drive file.</p>
    <form id="deleteInvoiceForm" method="POST">
      <label for="deletePinInput">Enter Admin PIN:</label>
      <input id="deletePinInput" name="pin" type="password" inputmode="numeric" maxlength="8" placeholder="••••" required autocomplete="off">
      <div class="delete-actions">
        <button type="button" class="delete-cancel" onclick="closeDeletePinModal()">Cancel</button>
        <button type="submit" class="delete-confirm">Delete Permanently</button>
      </div>
    </form>
  </div>
</div>

<script>
function openDeletePinModal(invoiceId, invNum) {
  document.getElementById('deleteModalInvNum').innerText = invNum || 'Invoice';
  document.getElementById('deleteInvoiceForm').action = '/invoice/' + invoiceId + '/delete';
  document.getElementById('deletePinInput').value = '';
  document.getElementById('reportDeleteModal').classList.add('open');
  setTimeout(() => document.getElementById('deletePinInput').focus(), 100);
}

function closeDeletePinModal() {
  document.getElementById('reportDeleteModal').classList.remove('open');
}

// Close on backdrop click
document.getElementById('reportDeleteModal')?.addEventListener('click', function(e) {
  if (e.target === this) closeDeletePinModal();
});
</script>

<%- include('partials/footer') %>