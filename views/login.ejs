<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07111f">
<title>GST Invoice Manager — Login</title>
<link rel="stylesheet" href="/login.css">
</head>
<body>
<div class="login-bg"><span class="orb orb-one"></span><span class="orb orb-two"></span><span class="orb orb-three"></span></div>
<main class="login-shell">
  <section class="login-showcase">
    <div class="showcase-top">
      <div class="brand-mark">₹</div>
      <div><strong>GST INVOICE</strong><small>MANAGER</small></div>
    </div>
    <div class="showcase-copy">
      <div class="eyebrow"><span></span> SMART BUSINESS WORKSPACE</div>
      <h1>Manage your GST<br><b>workspace beautifully.</b></h1>
      <p>Invoices, parties, reports and business settings — all arranged in one clean workspace.</p>
    </div>
    <div class="feature-orbit">
      <div class="orbit-ring ring-one"></div><div class="orbit-ring ring-two"></div>
      <div class="orbit-center"><span>₹</span><small>GST</small></div>
      <div class="orbit-chip chip-one">▤ <b>Reports</b></div>
      <div class="orbit-chip chip-two">♙ <b>Parties</b></div>
      <div class="orbit-chip chip-three">↥ <b>Invoice</b></div>
      <div class="orbit-chip chip-four">⚙ <b>Settings</b></div>
    </div>
    <div class="showcase-foot"><span class="pulse"></span> Your business dashboard is ready</div>
  </section>
  <section class="login-panel">
    <div class="login-card">
      <div class="mobile-brand"><div class="brand-mark">₹</div><div><strong>GST INVOICE</strong><small>MANAGER</small></div></div>
      <div class="login-heading">
        <span class="mini-badge">WELCOME BACK</span>
        <h2>Sign in to your<br><b>GST workspace</b></h2>
        <p>Enter your details to continue to the dashboard.</p>
      </div>
      <form id="loginForm" method="POST" action="/login" autocomplete="on">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <label class="field-label" for="loginUser">Username or Email</label>
        <div class="input-wrap"><span>◉</span><input id="loginUser" name="username" type="text" placeholder="Enter username" required autocomplete="username"></div>
        <label class="field-label" for="loginPassword">Password</label>
        <div class="input-wrap"><span>⌑</span><input id="loginPassword" name="password" type="password" placeholder="Enter password" required autocomplete="current-password"><button type="button" id="showPassword" aria-label="Show password">◉</button></div>
        <div class="login-options"><label><input id="rememberMe" type="checkbox" checked><span>Remember me</span></label></div>
        <button class="login-button" type="submit"><span>Enter Dashboard</span><b>→</b></button>
        <% if(error){ %>
          <div id="loginMessage" class="login-message" style="color:#ef4444;display:block;margin-top:12px;font-size:12px;font-weight:600;"><%= error %></div>
        <% } else { %>
          <div id="loginMessage" class="login-message" aria-live="polite"></div>
        <% } %>
      </form>
      <div class="secure-note"><span>✓</span><div><strong>Private workspace</strong><small>Secured with session authentication.</small></div></div>
    </div>
    <footer>© 2026 GST Invoice Manager <span>•</span> Business Management Workspace</footer>
  </section>
</main>
<script>
  const pass = document.getElementById('loginPassword');
  const show = document.getElementById('showPassword');
  if (show && pass) {
    show.addEventListener('click', () => {
      const visible = pass.type === 'text';
      pass.type = visible ? 'password' : 'text';
      show.textContent = visible ? '◉' : '◌';
    });
  }
</script>
</body>
</html>
