<%- include('partials/header') %>
<link rel="stylesheet" href="/settings.css">

<div class="settings-module" style="padding-top:10px;">
  <!-- Settings Tabs -->
  <div class="settings-shortcuts" role="tablist">
    <a href="/settings/company" class="settings-shortcut active" style="text-decoration:none;">
      <span>🏢</span><small class="setting-label">Company</small>
    </a>
    <a href="/settings/google" class="settings-shortcut" style="text-decoration:none;">
      <span>☁</span><small class="setting-label">Google Auth</small>
    </a>
    <a href="/settings/gemini" class="settings-shortcut" style="text-decoration:none;">
      <span>✦</span><small class="setting-label">Gemini AI</small>
    </a>
    <a href="/settings/email" class="settings-shortcut" style="text-decoration:none;">
      <span>📝</span><small class="setting-label">Email Template</small>
    </a>
  </div>

  <% if(saved){ %>
    <div style="background:#DCFCE7;border:1px solid #86EFAC;color:#15803D;padding:12px 18px;border-radius:14px;margin-bottom:18px;font-size:13px;font-weight:700;display:flex;align-items:center;gap:8px;">
      <span>✓</span> Settings saved successfully!
    </div>
  <% } %>

  <div class="settings-panel active">
    <div class="settings-panel-title">
      <div class="panel-icon">🏢</div>
      <div><h2>Company Setting</h2><p>यही नाम इनवॉइस में BUY और SELL पहचानने के लिए इस्तेमाल होता है।</p></div>
    </div>
    <form method="POST" action="/settings/company">
      <div class="company-settings-card" style="padding:24px;border-radius:20px;background:#fff;border:1px solid #E2E8F0;box-shadow:10px 12px 22px rgba(15,23,42,0.06);">
        <div style="margin-bottom:20px;">
          <label style="display:block;font-size:12px;font-weight:800;color:#334155;margin-bottom:8px;">Company / Firm Name</label>
          <input name="companyName" value="<%= process.env.COMPANY_NAME || '' %>" required placeholder="Easy Recharge Solution" style="width:100%;height:46px;padding:0 14px;border:1px solid #CBD5E1;border-radius:12px;font-size:13px;font-weight:600;outline:none;">
        </div>
        <button type="submit" class="primary" style="height:44px;padding:0 24px;font-size:12px;">Save Company Name</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
