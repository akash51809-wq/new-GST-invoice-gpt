<%- include('partials/header') %>

<div class="party-page">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <div>
      <h2 style="margin:0;font-size:22px;color:#0F172A;">Invoice Details</h2>
      <p style="margin:4px 0 0;font-size:12px;color:#64748B;">Invoice No: <strong style="color:#2563EB;"><%= inv.invoiceNumber || '-' %></strong></p>
    </div>
    <div style="display:flex;gap:10px;">
      <a class="primary light" href="/reports/invoices" style="text-decoration:none;font-size:11px;">← Back to Invoices</a>
      <a class="primary" href="/invoice/<%= inv._id %>/download" style="text-decoration:none;font-size:11px;">⬇ Download PDF</a>
    </div>
  </div>

  <div class="grid-2">
    <!-- Invoice Info Card -->
    <div class="panel" style="background:#fff;border:1px solid #E2E8F0;border-radius:20px;padding:24px;box-shadow:10px 12px 22px rgba(15,23,42,0.06);">
      <div class="panel-head" style="margin-bottom:18px;">
        <div>
          <span class="panel-kicker">SUMMARY</span>
          <h3 style="margin:4px 0 0;font-size:16px;">Billing Details</h3>
        </div>
        <span style="padding:5px 10px;border-radius:8px;font-size:11px;font-weight:700;<%= inv.invoiceType === 'BUY' ? 'background:#DCFCE7;color:#16A34A;' : 'background:#FEF3C7;color:#D97706;' %>">
          <%= inv.invoiceType %> INVOICE
        </span>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;font-size:13px;">
        <div style="background:#F8FAFC;padding:12px;border-radius:12px;">
          <small style="color:#64748B;display:block;">Invoice Number</small>
          <strong style="color:#0F172A;font-size:14px;"><%= inv.invoiceNumber || '-' %></strong>
        </div>
        <div style="background:#F8FAFC;padding:12px;border-radius:12px;">
          <small style="color:#64748B;display:block;">Invoice Date</small>
          <strong style="color:#0F172A;font-size:14px;"><%= inv.invoiceDate ? new Date(inv.invoiceDate).toLocaleDateString('en-IN') : '-' %></strong>
        </div>
        <div style="background:#F8FAFC;padding:12px;border-radius:12px;">
          <small style="color:#64748B;display:block;">Invoice Amount</small>
          <strong style="color:#16A34A;font-size:16px;">₹ <%= (inv.invoiceAmount || 0).toLocaleString('en-IN') %></strong>
        </div>
        <div style="background:#F8FAFC;padding:12px;border-radius:12px;">
          <small style="color:#64748B;display:block;">Email Status</small>
          <strong style="<%= inv.emailSent ? 'color:#16A34A;' : 'color:#D97706;' %>">
            <%= inv.emailSent ? '✓ Sent' : '○ Not Sent' %>
          </strong>
        </div>
      </div>

      <div style="margin-top:20px;border-top:1px solid #E2E8F0;padding-top:16px;">
        <h4 style="margin:0 0 10px;font-size:13px;color:#334155;">Parties Involved</h4>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;font-size:12px;">
          <div style="border:1px solid #E2E8F0;padding:12px;border-radius:12px;">
            <span style="color:#2563EB;font-weight:700;">BUYER</span>
            <div style="font-weight:700;margin:4px 0;"><%= inv.buyerName || '-' %></div>
            <div style="color:#64748B;">GSTIN: <%= inv.buyerGSTIN || '-' %></div>
          </div>
          <div style="border:1px solid #E2E8F0;padding:12px;border-radius:12px;">
            <span style="color:#059669;font-weight:700;">SELLER</span>
            <div style="font-weight:700;margin:4px 0;"><%= inv.sellerName || '-' %></div>
            <div style="color:#64748B;">GSTIN: <%= inv.sellerGSTIN || '-' %></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Storage & Cloud Card -->
    <div class="panel" style="background:#fff;border:1px solid #E2E8F0;border-radius:20px;padding:24px;box-shadow:10px 12px 22px rgba(15,23,42,0.06);">
      <div class="panel-head" style="margin-bottom:18px;">
        <div>
          <span class="panel-kicker">STORAGE & AI</span>
          <h3 style="margin:4px 0 0;font-size:16px;">Cloud & Drive Link</h3>
        </div>
      </div>

      <div style="background:#F8FAFC;padding:14px;border-radius:14px;font-size:12px;margin-bottom:14px;">
        <span style="color:#64748B;display:block;">Original File Name</span>
        <strong style="color:#0F172A;word-break:break-all;"><%= inv.originalFileName || '-' %></strong>
      </div>

      <div style="background:#F8FAFC;padding:14px;border-radius:14px;font-size:12px;margin-bottom:14px;">
        <span style="color:#64748B;display:block;">Google Drive File ID</span>
        <code style="color:#2563EB;word-break:break-all;"><%= inv.driveFileId || '-' %></code>
      </div>

      <div style="background:#F8FAFC;padding:14px;border-radius:14px;font-size:12px;margin-bottom:20px;">
        <span style="color:#64748B;display:block;">Financial Year / Month</span>
        <strong><%= inv.financialYear || '-' %> / <%= inv.month || '-' %></strong>
      </div>

      <form method="POST" action="/invoice/<%= inv._id %>/email" style="margin-bottom:10px;">
        <button type="submit" class="primary" style="width:100%;height:44px;font-size:12px;display:flex;align-items:center;justify-content:center;gap:8px;">
          ✉ Send Invoice Email to Party
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
