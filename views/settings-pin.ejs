<%- include('partials/header') %>
<link rel="stylesheet" href="/settings.css">

<div class="settings-module" style="display:flex;justify-content:center;align-items:center;min-height:55vh;padding:20px 0;">
  <div style="width:100%;max-width:440px;background:#ffffff;border:1px solid #E2E8F0;border-radius:24px;padding:36px 32px;box-shadow:0 20px 35px -10px rgba(15,23,42,0.12),0 1px 3px rgba(15,23,42,0.05);text-align:center;">
    <div style="width:64px;height:64px;margin:0 auto 18px;border-radius:20px;background:linear-gradient(135deg,#EFF6FF,#DBEAFE);display:grid;place-items:center;font-size:28px;box-shadow:inset 1px 1px 2px rgba(255,255,255,0.9),0 8px 16px -4px rgba(37,99,235,0.2);">
      🔒
    </div>
    <h2 style="font-size:22px;font-weight:800;color:#0F172A;margin:0 0 6px;">Security PIN Required</h2>
    <p style="font-size:13px;color:#64748B;line-height:1.5;margin:0 0 24px;">
      Google Credentials aur System Settings dekhne ya badalne ke liye apna Security PIN darj karein.
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background:#FEE2E2;border:1px solid #FCA5A5;color:#B91C1C;padding:10px 14px;border-radius:12px;margin-bottom:20px;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:6px;">
        <span>⚠</span> <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/settings/unlock-pin" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="returnUrl" value="<%= typeof returnUrl !== 'undefined' ? returnUrl : '/settings' %>">

      <div style="margin-bottom:22px;">
        <label for="settingsPinInput" style="display:block;text-align:left;font-size:12px;font-weight:700;color:#334155;margin-bottom:8px;">Enter PIN</label>
        <div style="position:relative;">
          <input id="settingsPinInput" name="pin" type="password" maxlength="8" inputmode="numeric" placeholder="••••" required autofocus
            style="width:100%;height:50px;font-size:24px;letter-spacing:8px;text-align:center;border:2px solid #CBD5E1;border-radius:14px;outline:none;transition:border-color .18s;box-shadow:inset 0 2px 4px rgba(0,0,0,0.04);">
        </div>
      </div>

      <button type="submit" style="width:100%;height:48px;font-size:14px;font-weight:700;border-radius:14px;background:linear-gradient(145deg,#2563eb,#1d4ed8);color:#fff;border:none;cursor:pointer;box-shadow:0 4px 14px rgba(37,99,235,0.3);transition:transform .15s;">
        Unlock Settings &nbsp;➔
      </button>
    </form>

    <div style="margin-top:24px;padding-top:16px;border-top:1px solid #F1F5F9;font-size:11px;color:#94A3B8;">
      🛡 Protected by GST Workspace Admin Security &bull; Default PIN: <code>1234</code>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
