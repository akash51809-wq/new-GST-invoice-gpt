<%- include('partials/header') %>
<link rel="stylesheet" href="/upload.css">

<div id="upload" class="page-section">
<div class="upload-page">
  <div class="upload-layout">
    <section class="upload-main-card">
      <div class="dropzone" id="invoiceDropzone">
        <div class="upload-box-title"><h2>Upload Invoices</h2></div>
        <div class="dropzone-center">
          <div class="dropzone-icon" aria-hidden="true">
            <svg class="upload-cloud-art" viewBox="0 0 180 130" role="img">
              <defs>
                <linearGradient id="uploadCloudGrad" x1="20" y1="15" x2="150" y2="115" gradientUnits="userSpaceOnUse">
                  <stop offset="0" stop-color="#38BDF8"/>
                  <stop offset="1" stop-color="#2563EB"/>
                </linearGradient>
                <filter id="uploadCloudShadow" x="-30%" y="-30%" width="160%" height="170%">
                  <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#2563EB" flood-opacity=".24"/>
                </filter>
              </defs>
              <path d="M43 102h83c20 0 34-13 34-30 0-16-12-29-28-31-5-18-21-30-40-30-21 0-38 15-42 35C32 47 18 61 18 77c0 15 11 25 25 25Z"
                fill="url(#uploadCloudGrad)" filter="url(#uploadCloudShadow)"/>
              <path d="M88 79V43m0 0-14 14m14-14 14 14" fill="none" stroke="#fff" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
              <g transform="rotate(9 133 83)">
                <rect x="112" y="62" width="42" height="51" rx="7" fill="#fff" stroke="#D7E5F4" stroke-width="2"/>
                <path d="M143 62v12h11" fill="#E8F3FF"/>
                <rect x="117" y="82" width="32" height="18" rx="5" fill="#FF4D55"/>
                <text x="133" y="95" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" font-weight="900" fill="#fff">PDF</text>
              </g>
              <circle cx="25" cy="31" r="3" fill="#38BDF8"/>
              <circle cx="157" cy="28" r="3" fill="#2563EB"/>
            </svg>
          </div>
          <h3>Drop invoice PDFs here</h3>
          <p>Drag & drop your GST invoice files here, or select them from your computer.</p>
          <input id="invoiceFileInput" type="file" accept=".pdf,application/pdf" multiple hidden>
          <div class="upload-actions">
            <button class="primary" id="chooseInvoiceBtn" type="button">＋ Choose PDF Files</button>
            <button class="primary light" id="processInvoiceBtn" type="button">↑ Upload &amp; Process</button>
          </div>
          <small>Maximum 50 files • 25 MB per file • PDF format</small>
          <div class="upload-progress" id="uploadProgress" hidden>
            <div class="upload-progress-top"><span id="uploadStatus">Ready</span><strong id="uploadPercent">0%</strong></div>
            <div class="upload-progress-track"><i id="uploadProgressFill"></i></div>
          </div>
        </div>

        <section class="upload-process-card" aria-label="Invoice processing steps">
          <div class="process-track">
            <div class="process-line"><i id="processLineFill" style="width:0%;"></i></div>
            <div class="process-step active" id="step1"><b>01</b><span>Upload</span></div>
            <div class="process-step" id="step2"><b>02</b><span>AI Extract</span></div>
            <div class="process-step" id="step3"><b>03</b><span>Validate</span></div>
            <div class="process-step" id="step4"><b>04</b><span>Drive Store</span></div>
            <div class="process-step" id="step5"><b>05</b><span>Complete</span></div>
          </div>
        </section>
      </div>
    </section>

    <aside class="workflow-card">
      <div class="workflow-glow"></div>
      <div class="workflow-head">
        <span class="workflow-icon">✦</span>
        <div><strong>AUTOMATED WORKFLOW</strong><small>Live AI invoice processing pipeline</small></div>
      </div>
      <div class="workflow-list">
        <div class="workflow-item"><b>01</b><span>Gemini AI extraction</span><em>READY</em></div>
        <div class="workflow-item"><b>02</b><span>Buyer / Seller classification</span><em>READY</em></div>
        <div class="workflow-item"><b>03</b><span>Duplicate invoice detection</span><em>READY</em></div>
        <div class="workflow-item"><b>04</b><span>Google Drive auto-storage</span><em>READY</em></div>
        <div class="workflow-item"><b>05</b><span>Automated email workflow</span><em>READY</em></div>
      </div>
      <div class="workflow-foot"><span class="pulse"></span> System active & listening</div>
    </aside>
  </div>

  <section class="upload-table-card" style="margin-top:22px;">
    <div class="table-head">
      <div><span class="process-kicker">QUEUE & RESULTS</span><h3 id="tableHeading">Selected Invoices</h3></div>
      <span class="table-live"><i id="liveIndicatorDot"></i> <span id="fileCountBadge">0 files</span></span>
    </div>
    <div class="invoice-table-wrap">
      <table class="invoice-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Invoice File</th>
            <th>Size</th>
            <th>Type / Party</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="invoiceTableBody">
          <tr class="empty-row"><td colspan="5" style="text-align:center;padding:24px;color:#94A3B8;">No invoices selected yet. Choose PDF files above.</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</div>
</div>

<!-- Modern Glassmorphic Email Modal for Unsent Previous Month Invoices -->
<div id="emailModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.65);backdrop-filter:blur(6px);z-index:2000;align-items:center;justify-content:center;">
  <div style="background:#fff;border:1px solid #E2E8F0;border-radius:24px;width:440px;max-width:92%;padding:28px;box-shadow:0 25px 50px rgba(15,23,42,0.25);">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
      <span style="width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:#FEF3C7;color:#D97706;font-size:18px;">✉</span>
      <div>
        <h3 style="margin:0;font-size:17px;color:#0F172A;">Party Email Required</h3>
        <small style="color:#64748B;">SELL invoice auto-email workflow</small>
      </div>
    </div>
    <p style="font-size:12px;color:#475569;margin-bottom:16px;line-height:1.6;">यह SELL इनवॉइस पिछले महीने का है। पार्टी को इनवॉइस ऑटो-ईमेल करने के लिए कृपया ईमेल दर्ज करें:</p>
    <div style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:14px;padding:12px 14px;font-size:12px;margin-bottom:16px;">
      <div style="margin-bottom:4px;">Party: <strong id="modalPartyName" style="color:#0F172A;"></strong></div>
      <div>Invoice No: <strong id="modalInvNum" style="color:#2563EB;"></strong></div>
      <div id="modalQueueInfo" style="margin-top:6px;font-size:10px;color:#64748B;"></div>
    </div>
    <input type="hidden" id="modalPartyId">
    <input type="hidden" id="modalInvoiceId">
    <label style="display:block;font-size:11px;font-weight:700;color:#334155;margin-bottom:6px;">पार्टी का ईमेल:</label>
    <input type="email" id="modalEmailInput" placeholder="party@example.com" style="width:100%;height:44px;padding:0 14px;border:1px solid #CBD5E1;border-radius:12px;font-size:13px;outline:none;margin-bottom:18px;">
    <div style="display:flex;justify-content:flex-end;gap:10px;">
      <button type="button" class="primary light" onclick="skipEmailModal()" style="font-size:11px;">Skip</button>
      <button type="button" class="primary" id="sendEmailBtn" onclick="saveAndSendModalEmail()" style="font-size:11px;">Save &amp; Send Mail</button>
    </div>
  </div>
</div>

<script>
(function(){
  const fileInput = document.getElementById('invoiceFileInput');
  const dropzone = document.getElementById('invoiceDropzone');
  const chooseBtn = document.getElementById('chooseInvoiceBtn');
  const processBtn = document.getElementById('processInvoiceBtn');
  const tableBody = document.getElementById('invoiceTableBody');
  const badge = document.getElementById('fileCountBadge');
  const progressDiv = document.getElementById('uploadProgress');
  const fill = document.getElementById('uploadProgressFill');
  const statusSpan = document.getElementById('uploadStatus');
  const percentStrong = document.getElementById('uploadPercent');
  const lineFill = document.getElementById('processLineFill');

  let selectedFiles = [];
  const formatBytes = b => b < 1048576 ? Math.round(b / 1024) + ' KB' : (b / 1048576).toFixed(1) + ' MB';

  function renderQueue() {
    badge.textContent = selectedFiles.length + ' file' + (selectedFiles.length === 1 ? '' : 's');
    if (!selectedFiles.length) {
      tableBody.innerHTML = '<tr class="empty-row"><td colspan="5" style="text-align:center;padding:24px;color:#94A3B8;">No invoices selected yet. Choose PDF files above.</td></tr>';
      return;
    }
    tableBody.innerHTML = selectedFiles.map((f, i) => `
      <tr>
        <td>${String(i + 1).padStart(2, '0')}</td>
        <td><strong>${f.name.replace(/</g, '&lt;')}</strong></td>
        <td>${formatBytes(f.size)}</td>
        <td><span style="color:#64748B;">Ready to parse</span></td>
        <td><span style="background:#EFF6FF;color:#2563EB;padding:4px 8px;border-radius:6px;font-size:10px;font-weight:700;">READY</span></td>
      </tr>
    `).join('');
  }

  function addFiles(files) {
    const pdfs = Array.from(files || []).filter(f => f.type === 'application/pdf' || /\.pdf$/i.test(f.name));
    selectedFiles = [...selectedFiles, ...pdfs].slice(0, 50);
    renderQueue();
  }

  chooseBtn.onclick = () => fileInput.click();
  fileInput.onchange = () => { addFiles(fileInput.files); fileInput.value = ''; };

  ['dragenter', 'dragover'].forEach(e => dropzone.addEventListener(e, x => { x.preventDefault(); dropzone.classList.add('dragover'); }));
  ['dragleave', 'drop'].forEach(e => dropzone.addEventListener(e, x => { x.preventDefault(); dropzone.classList.remove('dragover'); }));
  dropzone.addEventListener('drop', e => addFiles(e.dataTransfer.files));

  // Process pipeline animation
  function setPipelineStep(stepIdx) {
    for (let i = 1; i <= 5; i++) {
      const step = document.getElementById('step' + i);
      if (!step) continue;
      step.classList.toggle('active', i === stepIdx);
      step.classList.toggle('done', i < stepIdx);
    }
    lineFill.style.width = ((stepIdx - 1) * 25) + '%';
  }

  processBtn.onclick = async () => {
    if (!selectedFiles.length) {
      fileInput.click();
      return;
    }

    processBtn.disabled = true;
    chooseBtn.disabled = true;
    progressDiv.hidden = false;
    statusSpan.textContent = 'Uploading ' + selectedFiles.length + ' invoices...';
    percentStrong.textContent = '20%';
    fill.style.width = '20%';
    setPipelineStep(1);

    const formData = new FormData();
    selectedFiles.forEach(f => formData.append('invoices', f));

    // Animate to Step 2 (AI Extract)
    setTimeout(() => {
      setPipelineStep(2);
      statusSpan.textContent = 'Gemini AI parsing & extracting invoice data...';
      percentStrong.textContent = '45%';
      fill.style.width = '45%';
    }, 1200);

    try {
      const res = await fetch('/api/invoices/upload', {
        method: 'POST',
        body: formData
      });

      if (!res.ok) {
        let errMsg = 'Upload failed (HTTP ' + res.status + ')';
        try {
          const errData = await res.json();
          if (errData && errData.error) errMsg = errData.error;
        } catch(e) {}
        throw new Error(errMsg);
      }

      setPipelineStep(4);
      statusSpan.textContent = 'Storing files & creating database records...';
      percentStrong.textContent = '80%';
      fill.style.width = '80%';

      const data = await res.json();
      setPipelineStep(5);
      fill.style.width = '100%';
      percentStrong.textContent = '100%';
      statusSpan.textContent = 'Processing completed!';

      // Render actual results from backend
      if (data.results && data.results.length) {
        document.getElementById('tableHeading').textContent = 'Processed Invoices Results';
        tableBody.innerHTML = data.results.map((r, i) => {
          let statusBadge = '';
          if (r.status === 'completed') {
            statusBadge = '<span style="background:#DCFCE7;color:#16A34A;padding:4px 8px;border-radius:6px;font-size:10px;font-weight:700;">✓ COMPLETED</span>';
          } else if (r.status === 'duplicate') {
            statusBadge = '<span style="background:#FEF3C7;color:#D97706;padding:4px 8px;border-radius:6px;font-size:10px;font-weight:700;">⚠ DUPLICATE</span>';
          } else {
            statusBadge = `<span style="background:#FEE2E2;color:#EF4444;padding:4px 8px;border-radius:6px;font-size:10px;font-weight:700;" title="${(r.error||'').replace(/"/g,'&quot;')}">✕ FAILED</span>`;
          }

          let partyInfo = r.partyName ? `<strong>${r.partyName}</strong><br><small style="color:#64748B;">Inv: ${r.invoiceNumber || '-'} (${r.invoiceType || '-'})</small>` : `<span style="color:#EF4444;font-size:11px;">${r.error || '-'}</span>`;
          if (r.driveNotice) {
            partyInfo += `<br><small style="color:#D97706;">⚡ Saved locally (Google Drive authorization needed in Settings)</small>`;
          }

          return `
            <tr>
              <td>${String(i + 1).padStart(2, '0')}</td>
              <td><strong>${(r.file || '').replace(/</g, '&lt;')}</strong></td>
              <td>PDF</td>
              <td>${partyInfo}</td>
              <td>${statusBadge}</td>
            </tr>
          `;
        }).join('');
      }

      // Check for pending email queue
      if (data.pendingEmails && data.pendingEmails.length) {
        window.startEmailQueue(data.pendingEmails);
      }

    } catch (err) {
      statusSpan.textContent = 'Error: ' + err.message;
      statusSpan.style.color = '#EF4444';
    } finally {
      processBtn.disabled = false;
      chooseBtn.disabled = false;
      selectedFiles = [];
    }
  };

  // Missing email workflow
  let pendingQueue = [];
  let currentIndex = 0;
  let partyEmailCache = {};

  window.startEmailQueue = function(queue) {
    pendingQueue = queue || [];
    currentIndex = 0;
    if (pendingQueue.length > 0) {
      showCurrentEmailModal();
    }
  };

  function showCurrentEmailModal() {
    if (currentIndex >= pendingQueue.length) {
      document.getElementById('emailModal').style.display = 'none';
      return;
    }
    const item = pendingQueue[currentIndex];
    document.getElementById('modalPartyName').innerText = item.partyName;
    document.getElementById('modalInvNum').innerText = item.invoiceNumber;
    document.getElementById('modalPartyId').value = item.partyId;
    document.getElementById('modalInvoiceId').value = item.invoiceId;
    document.getElementById('modalQueueInfo').innerText = `Invoice ${currentIndex + 1} of ${pendingQueue.length}`;
    document.getElementById('modalEmailInput').value = partyEmailCache[item.partyId] || '';
    document.getElementById('emailModal').style.display = 'flex';
  }

  window.skipEmailModal = function() {
    currentIndex++;
    showCurrentEmailModal();
  };

  window.saveAndSendModalEmail = async function() {
    const partyId = document.getElementById('modalPartyId').value;
    const invoiceId = document.getElementById('modalInvoiceId').value;
    const email = document.getElementById('modalEmailInput').value.trim();
    if (!email) {
      alert('कृपया ईमेल आईडी दर्ज करें!');
      return;
    }

    const sendBtn = document.getElementById('sendEmailBtn');
    sendBtn.disabled = true;
    sendBtn.innerText = 'Sending...';

    try {
      const res = await fetch('/api/parties/save-email-and-send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ partyId, email, invoiceId })
      });
      const d = await res.json();
      if (!res.ok) throw new Error(d.error || 'Failed');
      partyEmailCache[partyId] = email;
      currentIndex++;
      showCurrentEmailModal();
    } catch (e) {
      alert('Error: ' + e.message);
    } finally {
      sendBtn.disabled = false;
      sendBtn.innerText = 'Save & Send Mail';
    }
  };
})();
</script>

<%- include('partials/footer') %>