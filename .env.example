# ============================================================
# GST Invoice GPT — Environment Variables
# ============================================================
# Is file ko copy karke .env naam do aur apni values bharo
# cp .env.example .env
# ============================================================

# Server & Cryptography
PORT=4322
SESSION_SECRET=koi_bhi_random_string_yahan_likho
# OWASP Token Cryptographic Storage (Optional: 64-character hex key for AES-256-GCM encryption)
# Agar yeh set nahi kiya toh SESSION_SECRET se automatically strong 256-bit key derive hoti hai
# TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional: Set initial admin password (agar nahi diya toh console mein strong random password print hoga)
# ADMIN_DEFAULT_PASSWORD=YourStrongPasswordHere123!

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Company
COMPANY_NAME=Your Company Name

# Google OAuth & Drive
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4322/auth/google/callback
GOOGLE_DRIVE_ROOT=GST Invoices

# Gemini AI
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_API_KEYS=your_gemini_api_key_here

# Email
GMAIL_FROM_NAME=Your Company Name
EMAIL_SUBJECT_TEMPLATE=Invoice {BILL_NUMBER} - {COMPANY_NAME}
EMAIL_BODY_TEMPLATE=Dear {PARTY_NAME},\n\nPlease find attached invoice {BILL_NUMBER} dated {DATE} for {AMOUNT}.\n\nRegards,\n{COMPANY_NAME}

# Delete PIN (invoice delete ke liye)
DELETE_PIN=1234

# Auto Email (true/false)
AUTO_EMAIL=true
